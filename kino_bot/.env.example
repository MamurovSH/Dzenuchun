# ╔══════════════════════════════════════════════════════════════╗
# ║        Kino Bot Enterprise — Environment Configuration       ║
# ║  Copy to .env and fill in your values: cp .env.example .env  ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Telegram ──────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1122334455
BOT_NAME=🎬 Kino Bot Enterprise
BOT_USERNAME=kino_enterprise_bot

# ── Super Admin ───────────────────────────────────────────────────────────
SUPER_ADMIN_ID=123456789
# Comma-separated list of extra admin Telegram IDs
ADMIN_IDS=123456789,987654321

# ── PostgreSQL ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kino:kinopass@localhost:5432/kinodb

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── REST API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_RATE_LIMIT_PER_MINUTE=60

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change_me_dashboard_secret

# ── Features ──────────────────────────────────────────────────────────────
ENABLE_CHANNEL_GUARD=false
REQUIRED_CHANNEL=@your_channel
ENABLE_2FA=true
ENABLE_NOTIFICATIONS=true

# ── Cleanup ───────────────────────────────────────────────────────────────
CLEANUP_LOG_DAYS=30
CLEANUP_SESSION_DAYS=7
CLEANUP_BACKUP_DAYS=90

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
